# ==========================================
# RPG Bot & Escudo do Mestre - Configurações
# ==========================================

# Token do Bot do Discord (obtido no Discord Developer Portal: https://discord.com/developers/applications)
# Deixe em branco se for usar apenas no modo local pelo navegador
DISCORD_BOT_TOKEN=

# ID do Servidor Discord (Guild ID)
DISCORD_GUILD_ID=

# ID do Canal de Voz padrão para o bot tocar músicas e efeitos sonoros
DISCORD_VOICE_CHANNEL_ID=

# ID do Canal de Texto padrão para o bot enviar mensagens, rolagens de dados e fichas de NPCs
DISCORD_TEXT_CHANNEL_ID=

# ID da Aplicação / Client ID do Bot
DISCORD_CLIENT_ID=

# Prefixo de comandos no chat do Discord (padrão: !)
DISCORD_PREFIX=!

# Diretório de persistência dos dados locais (banco db.json, músicas, soundboard, npcs)
DATA_DIR=/app/data

# Porta de execução da aplicação web
PORT=3000

# Node Environment
NODE_ENV=production
