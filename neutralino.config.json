{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "app.caranguejorpg",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 3000,
  "url": "http://localhost:3000",
  "enableServer": false,
  "enableNativeAPI": false,
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "modes": {
    "window": {
      "title": "CaranguejoRPG - Escudo do Mestre & Som",
      "width": 1440,
      "height": 920,
      "minWidth": 1024,
      "minHeight": 700,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/assets/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "CaranguejoRPG",
    "resourcesPath": "/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.5.0",
    "clientVersion": "5.5.0"
  }
}
